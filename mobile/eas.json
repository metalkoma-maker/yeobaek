{
  "cli": {
    "version": ">= 25.1.1",
    "appVersionSource": "remote"
  },
  "build": {
    "simulator": {
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_YEOBAEK_MODE": "production"
      }
    },
    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_YEOBAEK_MODE": "production"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6832972862",
        "ascApiKeyPath": "$EXPO_ASC_API_KEY_PATH",
        "ascApiKeyIssuerId": "$EXPO_ASC_ISSUER_ID",
        "ascApiKeyId": "$EXPO_ASC_KEY_ID"
      }
    }
  }
}
